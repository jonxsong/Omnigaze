# Server-only OpenAI configuration
OPENAI_API_KEY=
# Optional. When omitted, the Agents SDK default model is used.
OPENAI_MODEL=

# Licensed market data and news
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Trading API host used only for the server-side asset catalog. Allowed values:
# https://paper-api.alpaca.markets or https://api.alpaca.markets
ALPACA_TRADING_API_BASE_URL=https://paper-api.alpaca.markets
# iex: real-time limited-exchange coverage; sip: real-time consolidated;
# delayed_sip: 15-minute delayed consolidated coverage.
ALPACA_DATA_FEED=iex

# SEC asks automated clients to identify their application and operator.
# Example: Omnigaze admin@your-domain.example
SEC_USER_AGENT=
