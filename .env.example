# Server-only OpenAI configuration
OPENAI_API_KEY=
# Optional. When omitted, the Agents SDK default model is used.
OPENAI_MODEL=
# Omnigaze enforces one shared AI usage policy in D1: five-minute single-stock
# view caches, owner-scoped Daily Brief caches (at most six hours), 20 generated
# analyses per owner per UTC day, 5 per rolling minute, and at most 2 active
# generations. Cache hits and in-process followers spend no added budget.

# Public canonical origin used by metadata, robots.txt, sitemap.xml, and JSON-LD.
# Canonical production origin for the public Omnigaze experience.
NEXT_PUBLIC_OMNIGAZE_URL=https://omnigaze.jonzhang.dev

# Privacy-bounded HTTP request telemetry. Ordinary successful completions are
# deterministically sampled by their server-generated request ID. Client/server
# errors and slow requests are always emitted. Use 1 during alpha; lower this
# before materially higher traffic. MCP is always emitted because JSON-RPC
# errors can use HTTP 200. Allowed values are from 0 through 1.
OMNIGAZE_TELEMETRY_SUCCESS_SAMPLE_RATE=1

# Licensed market data and news
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Trading API host used only for the server-side asset catalog. Allowed values:
# https://paper-api.alpaca.markets or https://api.alpaca.markets
ALPACA_TRADING_API_BASE_URL=https://paper-api.alpaca.markets
# iex: real-time limited-exchange coverage; sip: real-time consolidated;
# delayed_sip: 15-minute delayed consolidated coverage.
ALPACA_DATA_FEED=iex

# Bounded cursor ingestion. Symbols must be comma-separated canonical IDs.
# When omitted, the current core watchlist is used.
ALPACA_INGESTION_SYMBOLS=NASDAQ:NVDA,NASDAQ:MSFT,NASDAQ:AAPL,NASDAQ:AMD,NASDAQ:TSLA
# Exact authenticated Sites user ID allowed to invoke the operator MCP tick.
INGESTION_OPERATOR_USER_ID=
# Set to scheduled only after a linked hosted schedule is actually enabled.
INGESTION_COLLECTION_MODE=request_time
# Used for due times; publicly reported only when collection mode is scheduled.
INGESTION_EXPECTED_CADENCE_SECONDS=300

# Durable owner inbox/alert projection. Leave request_time until the hosted
# run_intelligence_projection_tick schedule is linked and has completed once.
INBOX_PROJECTION_COLLECTION_MODE=request_time
# Publicly reported only when projection collection mode is scheduled.
INBOX_PROJECTION_EXPECTED_CADENCE_SECONDS=300

# SEC request-time egress is fail-closed unless this exact flag is true and a
# truthful, monitored contact-bearing user agent is configured. Every SEC
# request is admitted through the shared D1 Fair Access coordinator.
SEC_EDGAR_ENABLED=false
# SEC asks automated clients to identify their application and operator.
# This value alone never activates production SEC egress.
# Example: Omnigaze admin@your-domain.example
SEC_USER_AGENT=

# Durable recent-filing collection is a second, independent exact opt-in. It
# remains inert unless SEC_EDGAR_ENABLED is also true, SEC_USER_AGENT is valid,
# the D1 Fair Access coordinator is ready, and the operator MCP tool is called.
SEC_DURABLE_INGESTION_ENABLED=false
# Only reviewed canonical symbols with stable CIK mappings are accepted.
SEC_INGESTION_SYMBOLS=NASDAQ:NVDA,NASDAQ:MSFT,NASDAQ:AAPL,NASDAQ:AMD,NASDAQ:TSLA
# Set to scheduled only after run_sec_filing_ingestion_tick has a linked,
# verified Sites schedule. Until then health remains honest about request time.
SEC_INGESTION_COLLECTION_MODE=request_time
SEC_INGESTION_EXPECTED_CADENCE_SECONDS=300
