# Server-only OpenAI configuration
OPENAI_API_KEY=
# Optional. When omitted, the Agents SDK default model is used.
OPENAI_MODEL=
# Omnigaze enforces its AI usage policy in D1: a five-minute evidence cache,
# 20 generated views per owner per UTC day, 5 per rolling minute, and at most
# 2 active generations. Cache hits do not spend another generation budget.

# Public canonical origin used by metadata, robots.txt, sitemap.xml, and JSON-LD.
# Keep this on the current HTTPS deployment until the custom domain is live.
NEXT_PUBLIC_OMNIGAZE_URL=https://omnigaze.perkyaisle4.chatgpt.site

# Licensed market data and news
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Trading API host used only for the server-side asset catalog. Allowed values:
# https://paper-api.alpaca.markets or https://api.alpaca.markets
ALPACA_TRADING_API_BASE_URL=https://paper-api.alpaca.markets
# iex: real-time limited-exchange coverage; sip: real-time consolidated;
# delayed_sip: 15-minute delayed consolidated coverage.
ALPACA_DATA_FEED=iex

# Bounded cursor ingestion. Symbols must be comma-separated canonical IDs.
# When omitted, the current core watchlist is used.
ALPACA_INGESTION_SYMBOLS=NASDAQ:NVDA,NASDAQ:MSFT,NASDAQ:AAPL,NASDAQ:AMD,NASDAQ:TSLA
# Exact authenticated Sites user ID allowed to invoke the operator MCP tick.
INGESTION_OPERATOR_USER_ID=
# Set to scheduled only after a linked hosted schedule is actually enabled.
INGESTION_COLLECTION_MODE=request_time
# Used for due times; publicly reported only when collection mode is scheduled.
INGESTION_EXPECTED_CADENCE_SECONDS=300

# SEC asks automated clients to identify their application and operator.
# Example: Omnigaze admin@your-domain.example
SEC_USER_AGENT=
